# Project Montage deployment config — reference for every key.
#
# `./deploy/deploy.sh setup --env <name>` asks for these values and writes
# deploy/config/<name>.env (gitignored). To set up without prompts, copy this
# file to deploy/config/<name>.env, fill it in and run setup with -y.
# Setup rewrites the file, so keep only the keys listed here in it.
#
# Extra environment variables for a service go in
# deploy/config/<name>.<mcp|client|sign>.env (dotenv format).

# ---------- Project ----------
PROJECT_ID="your-project-id"
REGION="us-central1"                # Cloud Run, registry, bucket and SQL
GOOGLE_CLOUD_LOCATION="global"      # Vertex AI location for Gemini/Veo
AR_REPO="montage"                   # Artifact Registry Docker repository
GCS_BUCKET_NAME="your-project-id-montage"
# Folder of candidate asset images the client offers to select_asset.
# Deployed to the client only; leave empty to disable asset selection.
GCS_INGREDIENT_IMAGES_FOLDER="gs://your-project-id-montage/ingredient-images"

# ---------- Service names ----------
MCP_SERVICE="montage-mcp"
CLIENT_SERVICE="montage-client"
SIGN_SERVICE="montage-sign"

# ---------- Service accounts (optional) ----------
# Empty means montage-<service>@PROJECT_ID.iam.gserviceaccount.com, created by
# setup. Name existing accounts here when constraints/iam.disableServiceAccountCreation
# is enforced; setup only creates accounts that belong to PROJECT_ID.
MCP_SERVICE_ACCOUNT=""
CLIENT_SERVICE_ACCOUNT=""
SIGN_SERVICE_ACCOUNT=""

# ---------- Cloud SQL on a private IP (optional) ----------
SQL_ENABLED="0"
SQL_INSTANCE="montage-sql"
SQL_TIER="db-f1-micro"
SQL_DATABASE="montage"
SQL_USER="montage"
# A name creates the network here. A Shared VPC is given by path instead:
#   VPC_NETWORK="projects/HOST/global/networks/NAME"
#   VPC_SUBNET="projects/HOST/regions/REGION/subnetworks/NAME"
# and its host project must already provide the subnet and private services access.
VPC_NETWORK="montage-vpc"
VPC_SUBNET="montage-subnet"
VPC_SUBNET_RANGE="10.10.0.0/24"

# ---------- Sign server (optional) ----------
SIGN_ENABLED="0"
VIEW_ENDPOINT=""                    # written by setup after deploying it

# ---------- Web client access: exactly one of IAP or public ----------
IAP_ENABLED="1"
# Comma-separated, each with a type prefix: user:, group:, domain:,
# serviceAccount:, or principal:// / principalSet:// (Workforce Identity Federation).
IAP_MEMBERS="group:montage-users@example.com,user:someone@example.com"
CLIENT_PUBLIC="0"
# Public services get an allUsers invoker binding. Where domain restricted
# sharing forbids allUsers, set 0 to turn off the invoker check instead.
PUBLIC_INVOKER_IAM_CHECK="1"
# Google's OAuth client admits only identities of the project's organization.
# To admit members from other organizations (or use a project without one),
# create an OAuth client, store its secret in Secret Manager and name both here.
IAP_OAUTH_CLIENT_ID=""
IAP_OAUTH_CLIENT_SECRET_NAME=""

# ---------- Organization policy settings (optional) ----------
# BUILD_REGION runs builds, and keeps their staging bucket, in one region
# (gcp.resourceLocations). BUILD_WORKER_POOL is a private pool,
# projects/P/locations/L/workerPools/NAME (cloudbuild.allowedWorkerPools).
# BUILD_SERVICE_ACCOUNT replaces the Compute Engine default account.
BUILD_REGION=""
BUILD_WORKER_POOL=""
BUILD_SERVICE_ACCOUNT=""
# Regions to keep the session secret in; empty is automatic replication,
# which a resource location policy may forbid. Comma-separated.
SECRET_LOCATIONS=""
# Customer-managed key for the registry, bucket, SQL, secret and Cloud Run
# (gcp.restrictNonCmekServices): projects/P/locations/REGION/keyRings/R/cryptoKeys/K
KMS_KEY=""
# Extra `gcloud run deploy` flags, space-separated: for every service, then per
# service. For example --ingress=..., --binary-authorization=default, --labels=...
RUN_DEPLOY_FLAGS=""
MCP_DEPLOY_FLAGS=""
CLIENT_DEPLOY_FLAGS=""
SIGN_DEPLOY_FLAGS=""

# ---------- Runtime resources ----------
MCP_CPU="2"
MCP_MEMORY="8Gi"
MCP_TIMEOUT="1200"
CLIENT_MEMORY="2Gi"
CLIENT_TIMEOUT="1200"
SIGN_MEMORY="512Mi"
